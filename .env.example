# Токен Telegram-бота. Получите у @BotFather -> /newbot
TG_BOT_TOKEN=123456:ABC-DEF_your_token_here

# Ваш числовой chat_id (кому слать уведомления).
# Узнать: напишите боту /start, он ответит вашим chat_id.
ADMIN_CHAT_ID=0

# Путь к SQLite базе (по умолчанию data/pravosudie.db)
# DB_PATH=data/pravosudie.db

# Уровень логирования: DEBUG | INFO | WARNING
LOG_LEVEL=INFO
