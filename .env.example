# Путь к SQLite базе с историей дел (по умолчанию data/pravosudie.db)
# DB_PATH=data/pravosudie.db

# Уровень логирования: DEBUG | INFO | WARNING
LOG_LEVEL=INFO

# --------------------------------------------------------------------------
# Распознавание капчи через vision-модель (необязательно).
# Локальный OCR (ddddocr) работает всегда. Если он не справляется, капча
# уходит в vision-модель — нужен ключ и доступ в интернет. Ключ можно взять
# у OpenAI (или совместимого сервиса; тогда задайте base_url/модель в config.yaml).
# --------------------------------------------------------------------------
# VISION_API_KEY=sk-...
# OPENAI_API_KEY=sk-...   # альтернативное имя переменной

# ── Yandex Cloud Foundation Models (работает из РФ) ──
# 1) создайте сервисный аккаунт с ролью ai.languageModels.user;
# 2) создайте ему API-ключ со scope yc.ai.languageModels.execute;
# 3) заполните обе переменные ниже, а в config.yaml поставьте
#    captcha_vision_auth_scheme: "api-key" и модель gpt://<folder_id>/<vision-модель>/latest
# VISION_API_KEY=<API-ключ сервисного аккаунта>
# YANDEX_FOLDER_ID=<id каталога, b1g...>

